# ====================================================================
# AVA WEBAPP - ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env.local for Next.js to pick it up
# Never commit .env.local to version control!
# ====================================================================

# --------------------------------------------------------------------
# 🔐 AUTHENTICATION (REQUIRED)
# --------------------------------------------------------------------
# NextAuth configuration
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Supabase Auth (Signin/Signup)
# Get from: Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only keys (do NOT expose client-side)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_ENABLE_SUPABASE_AUTH=false

# --------------------------------------------------------------------
# 🌐 API BACKEND (REQUIRED)
# --------------------------------------------------------------------
# Backend API URL for server-side requests
# Development: http://localhost:8000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend base URL (public, for client-side requests)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --------------------------------------------------------------------
# 📊 ANALYTICS & OBSERVABILITY (OPTIONAL)
# --------------------------------------------------------------------
# PostHog analytics (get key from: https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry error tracking (get DSN from: https://sentry.io)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Vercel Analytics (automatically enabled on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# --------------------------------------------------------------------
# 💳 STRIPE (OPTIONAL - for billing)
# --------------------------------------------------------------------
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------
# 🎯 FEATURE FLAGS
# --------------------------------------------------------------------
# Enable PWA (Progressive Web App)
NEXT_ENABLE_PWA=false

# Enable development features
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# --------------------------------------------------------------------
# 🔧 DEVELOPMENT (OPTIONAL)
# --------------------------------------------------------------------
# Bypass authentication in development mode
# WARNING: Only use in local development! NEVER enable in production!
# When enabled, you'll be automatically logged in as a mock user (addavner@gmail.com)
# This is useful when Supabase connection is unavailable (e.g., WiFi blocking)
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Mock services for development without external dependencies
# Set to 'mock' to use mocks, or leave empty/remove for real services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=

# Database URL (if webapp needs direct DB access - typically not needed)
DATABASE_URL=

# ====================================================================
# QUICK START CHECKLIST
# ====================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Generate NextAuth secret: openssl rand -base64 32
# 3. Set NEXT_PUBLIC_API_URL to your backend URL
# 4. (Optional) Add analytics keys for PostHog/Sentry
# 5. (Optional) Add Stripe keys for billing features
# 6. Start dev server: npm run dev
# ====================================================================
